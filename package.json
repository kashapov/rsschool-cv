{
  "name": "rsschool-cv",
  "version": "1.0.0",
  "description": "RS School CV — static HTML/CSS resume page",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "npm run lint:html && npm run lint:css",
    "lint:html": "htmlhint \"**/*.html\" --ignore \"node_modules/**,dist/**\"",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "htmlhint": "^1.1.4",
    "prettier": "^3.3.3",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "vite": "^7.1.5"
  }
}
